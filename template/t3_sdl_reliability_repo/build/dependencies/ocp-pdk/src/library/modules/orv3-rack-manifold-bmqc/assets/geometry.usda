#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Enclosure"
        {
            color3f[] primvars:displayColor = [(0.18, 0.24, 0.31)]
            double size = 1
            double3 xformOp:scale = (0.09, 0.12, 2.2)
            double3 xformOp:translate = (0.045, 0.06, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "supply_in"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.045, 0.06, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "return_out"
        {
            custom double3 texsys:normal = (0, 0, -1)
            double3 xformOp:translate = (0.045, 0.06, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "branch_supply"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.045, 0, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "branch_return"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.045, 0.12, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "pressure_sense"
        {
            custom double3 texsys:normal = (1, 0, 0)
            double3 xformOp:translate = (0.09, 0.06, 2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

