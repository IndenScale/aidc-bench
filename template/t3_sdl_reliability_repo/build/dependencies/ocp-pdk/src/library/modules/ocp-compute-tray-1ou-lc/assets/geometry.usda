#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Enclosure"
        {
            color3f[] primvars:displayColor = [(0.18, 0.24, 0.31)]
            double size = 1
            double3 xformOp:scale = (0.538, 0.9, 0.048)
            double3 xformOp:translate = (0.269, 0.45, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "dc_in"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.269, 0.9, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "bmqc_supply"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.42, 0.9, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "bmqc_return"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.48, 0.9, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_in"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.269, 0, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_out"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.269, 0.9, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "fabric_ew"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.12, 0, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "bmc_interlock"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.05, 0, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

