#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "PodEnclosure"
        {
            color3f[] primvars:displayColor = [(0.22, 0.3, 0.38)]
            double size = 1
            double3 xformOp:scale = (3.6, 2.8, 2.9)
            double3 xformOp:translate = (1.8, 1.4, 1.45)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "CduBay"
        {
            color3f[] primvars:displayColor = [(0.18, 0.56, 0.68)]
            double size = 1
            double3 xformOp:scale = (1.2, 1.2, 2.2)
            double3 xformOp:translate = (0.7, 0.8, 1.1500000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "power_a"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.4, 0, 2.9)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "power_b"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (3.2, 0, 2.9)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "fws_supply"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (1.2, 2.8, 2.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "fws_return"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (2.4, 2.8, 2.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "oob_mgmt"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (1.8, 0, 2.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "alarm"
        {
            custom double3 texsys:normal = (1, 0, 0)
            double3 xformOp:translate = (3.6, 1.4, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

