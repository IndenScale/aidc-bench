{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "冷冻水稳态压差工况表中的 pipe_outages",
  "type": "object",
  "propertyNames": {"$ref": "#/$defs/id"},
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source", "base_case", "base_case_digest", "unavailable_pipes"],
    "properties": {
      "source": {"$ref": "#/$defs/id"},
      "base_case": {"$ref": "#/$defs/id"},
      "base_case_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "unavailable_pipes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "switching": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"enum": ["open", "closed"]}}
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "\\S"}}
}
