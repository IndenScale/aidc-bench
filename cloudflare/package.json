{
  "name": "aidc-bench-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply aidc-bench-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply aidc-bench-db --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
