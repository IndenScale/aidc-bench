{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aidc-bench",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dashboard",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aidc-bench-db",
      "database_id": "6cb1e1fc-078c-45c5-b7a9-d6a12caf9397",
      "migrations_dir": "migrations"
    }
  ],
  // Enable R2 in Cloudflare Dashboard, create `aidc-bench-artifacts`, then uncomment:
  // "r2_buckets": [
  //   {
  //     "binding": "ARTIFACTS",
  //     "bucket_name": "aidc-bench-artifacts"
  //   }
  // ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
