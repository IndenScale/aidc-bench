{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Room differential-pressure observation runs",
  "definitions": {
    "point": {
      "type": "object",
      "properties": {
        "high": {
          "type": "string",
          "minLength": 1
        },
        "low": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "const": "Pa"
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "meter": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "calibration_source": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "high",
        "low",
        "value",
        "unit",
        "uncertainty",
        "meter",
        "source",
        "calibration_source"
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "steady_state": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "rooms": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "minLength": 1
            },
            "additionalProperties": {
              "$ref": "#/definitions/point"
            }
          }
        }
      },
      "required": [
        "run_id",
        "steady_state",
        "observed_at",
        "source",
        "rooms"
      ]
    }
  },
  "type": "object",
  "properties": {
    "kind": {
      "const": "room-pressure-observations"
    },
    "schema_version": {
      "const": 1
    },
    "domain": {
      "const": "hvac"
    },
    "baseline": {
      "type": "string",
      "minLength": 1
    },
    "frame": {
      "type": "string",
      "minLength": 1
    },
    "scene_digest": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/definitions/run"
      }
    }
  },
  "required": [
    "kind",
    "schema_version",
    "domain",
    "baseline",
    "frame",
    "scene_digest",
    "cases"
  ]
}
