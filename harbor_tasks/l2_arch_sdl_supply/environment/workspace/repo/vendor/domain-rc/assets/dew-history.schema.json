{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Time-aligned pipe surface and local dew point evidence, version 1",
  "type": "object",
  "required": ["schema_version", "kind", "frame", "scene_digest"],
  "properties": {"schema_version": {"const": 1}, "frame": {"$ref": "#/definitions/id"}, "scene_digest": {"$ref": "#/definitions/id"}},
  "definitions": {
    "id": {"type": "string", "minLength": 1},
    "pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "segment": {"type": "object", "required": ["pipe", "prim", "segment_index"], "properties": {
      "pipe": {"$ref": "#/definitions/id"}, "prim": {"$ref": "#/definitions/id"}, "segment_index": {"type": "integer", "minimum": 0}}},
    "selected": {"type": "object", "required": ["time_origin", "clock", "window_s", "run", "run_digest", "surface_point", "dew_point", "location_basis"],
      "properties": {"window_s": {"$ref": "#/definitions/pair"}, "time_origin": {"type": "string", "format": "date-time"}}},
    "channel": {"type": "object", "required": ["quantity", "source", "calibration", "interval_basis", "time_error_s", "intervals"],
      "properties": {"quantity": {"enum": ["surface-temperature", "air-dew-point"]}, "time_error_s": {"type": ["number", "null"], "minimum": 0},
        "intervals": {"type": "array", "items": {"type": "object", "required": ["time_s"], "properties": {"time_s": {"$ref": "#/definitions/pair"},
          "value_c": {"type": ["number", "null"]}, "error_c": {"type": ["number", "null"], "minimum": 0}}}}}},
    "case_result": {"type": "object", "required": ["time_origin", "clock", "clock_source", "run_digest", "window_s", "surface_basis", "dew_basis", "spans", "gaps_s"],
      "properties": {"window_s": {"$ref": "#/definitions/pair"}, "gaps_s": {"type": "array", "items": {"$ref": "#/definitions/pair"}},
        "spans": {"type": "array", "items": {"type": "object", "required": ["time_s", "surface_bounds_c", "dew_bounds_c", "margin_bounds_c"],
          "properties": {"time_s": {"$ref": "#/definitions/pair"}, "surface_bounds_c": {"$ref": "#/definitions/pair"},
            "dew_bounds_c": {"$ref": "#/definitions/pair"}, "margin_bounds_c": {"$ref": "#/definitions/pair"}}}}}}
  },
  "oneOf": [
    {"required": ["segments"], "properties": {"kind": {"const": "dew-observation-plan"}, "segments": {"type": "object", "additionalProperties": {
      "allOf": [{"$ref": "#/definitions/segment"}, {"required": ["cases"], "properties": {"cases": {"type": "object", "additionalProperties": {"$ref": "#/definitions/selected"}}}}]}}}},
    {"required": ["runs"], "properties": {"kind": {"const": "dew-observations"}, "runs": {"type": "object", "additionalProperties": {
      "allOf": [{"$ref": "#/definitions/segment"}, {"required": ["segment", "case", "source", "time_origin", "clock", "clock_source", "channels"],
        "properties": {"channels": {"type": "object", "additionalProperties": {"$ref": "#/definitions/channel"}}}}]}}}},
    {"required": ["domain", "plan_digest", "observations_digest", "segments", "unresolved"], "properties": {"kind": {"const": "dew-margin-history"},
      "domain": {"const": "thermal"}, "unresolved": {"type": "array"}, "segments": {"type": "object", "additionalProperties": {
        "allOf": [{"$ref": "#/definitions/segment"}, {"required": ["cases"], "properties": {"cases": {"type": "object", "additionalProperties": {"$ref": "#/definitions/case_result"}}}}]}}}}
  ]
}
