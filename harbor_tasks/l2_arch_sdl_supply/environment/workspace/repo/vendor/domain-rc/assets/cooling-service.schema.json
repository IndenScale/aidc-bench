  "definitions": {
    "caseIssue": {
      "type": "object",
      "properties": {
        "issue": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["issue"]
    },
    "allocation": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "room": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": ["string", "null"]
        },
        "kw": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": ["routed_kw", "withheld_kw", "pending_kw"]
        },
        "candidate_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": ["unit", "room", "route", "kw", "status", "candidate_routes"]
    },
    "allocationCase": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "unit_dispatch_kw": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "rooms": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "routed_kw": {
                "type": "number",
                "minimum": 0
              },
              "pending_kw": {
                "type": "number",
                "minimum": 0
              },
              "withheld_kw": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["routed_kw", "pending_kw", "withheld_kw"]
          }
        },
        "allocations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/allocation"
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "unit": {
                "type": ["string", "null"]
              },
              "room": {
                "type": ["string", "null"]
              },
              "state": {
                "enum": ["available", "offline", "unverified", "wrong-endpoint"]
              }
            },
            "required": ["unit", "room", "state"]
          }
        },
        "unavailable_units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unavailable_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "unit_dispatch_kw",
        "rooms",
        "allocations",
        "paths",
        "unavailable_units",
        "unavailable_routes"
      ]
    },
    "routeObservation": {
      "type": "object",
      "properties": {
        "length_m": {
          "type": "number",
          "minimum": 0
        },
        "prim": {
          "type": "string",
          "minLength": 1
        },
        "ends": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidates": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "xyz_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": ["candidates", "xyz_m"]
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["length_m", "prim", "ends"]
    },
    "transferLimit": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "maximum_kw": {
          "type": "number",
          "minimum": 0
        },
        "nonlimiting": {
          "const": true
        }
      },
      "required": ["source"],
      "oneOf": [
        {
          "required": ["maximum_kw"]
        },
        {
          "required": ["nonlimiting"]
        }
      ]
    },
    "solution": {
      "type": "object",
      "properties": {
        "maximum_kw": {
          "type": "number",
          "minimum": 0
        },
        "cut_capacity_kw": {
          "type": "number",
          "minimum": 0
        },
        "cut_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              "capacity_kw": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["from", "to", "capacity_kw"]
          }
        },
        "room_kw": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "route_kw": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": ["maximum_kw", "cut_capacity_kw", "cut_edges", "room_kw", "route_kw"]
    },
    "redistributionCase": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "ambient_c": {
          "type": "number"
        },
        "demand_kw": {
          "type": "number",
          "minimum": 0
        },
        "unit_capacity_kw": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "room_loads_kw": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "confirmed_routes": {
          "$ref": "#/definitions/solution"
        },
        "including_unverified_routes": {
          "$ref": "#/definitions/solution"
        },
        "unverified_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "ambient_c",
        "demand_kw",
        "unit_capacity_kw",
        "room_loads_kw",
        "confirmed_routes",
        "including_unverified_routes",
        "unverified_routes"
      ]
    }
  }
}
