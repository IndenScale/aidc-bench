{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cooling-performance v1",
  "definitions": {
    "unit": {
      "type": "object",
      "required": [],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "performance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ambient_c", "capacity_kw", "cop"],
            "properties": {
              "ambient_c": {
                "type": "number"
              },
              "capacity_kw": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "cop": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "rating": {
      "type": "object",
      "required": ["source", "product", "capacity_kw", "cop", "bracket_c"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "capacity_kw": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cop": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bracket_c": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "kind", "units"],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "cooling-product-data"
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/unit"
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "cases"],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "cooling-conditions"
        },
        "cases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [],
            "properties": {
              "ambient_c": {
                "type": ["number", "null"]
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "domain",
        "catalog_digest",
        "conditions_digest",
        "cases",
        "unresolved"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "cooling-performance"
        },
        "domain": {
          "const": "hvac"
        },
        "catalog_digest": {
          "type": "string",
          "minLength": 1
        },
        "conditions_digest": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["ambient_c", "units"],
            "properties": {
              "ambient_c": {
                "type": ["number", "null"]
              },
              "units": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/rating"
                }
              }
            }
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason"],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
