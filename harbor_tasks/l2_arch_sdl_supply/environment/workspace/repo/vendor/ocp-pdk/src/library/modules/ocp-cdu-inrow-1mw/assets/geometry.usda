        }

        def Xform "tcs_supply"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.16, 0.25, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tcs_return"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.44, 0.25, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "power_a"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.15, 0.6, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "power_b"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.45, 0.6, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
