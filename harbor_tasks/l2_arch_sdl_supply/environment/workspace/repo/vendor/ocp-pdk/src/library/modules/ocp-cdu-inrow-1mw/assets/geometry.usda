#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Cabinet"
        {
            color3f[] primvars:displayColor = [(0.18, 0.28, 0.36)]
            double size = 1
            double3 xformOp:scale = (0.6, 1.2, 2.2)
            double3 xformOp:translate = (0.3, 0.6, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "HmiPanel"
        {
            color3f[] primvars:displayColor = [(0.16, 0.68, 0.72)]
            double size = 1
            double3 xformOp:scale = (0.4, 0.03, 0.25)
            double3 xformOp:translate = (0.30000000000000004, 0.015, 1.575)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "fws_supply"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.16, 0.92, 2.2)
