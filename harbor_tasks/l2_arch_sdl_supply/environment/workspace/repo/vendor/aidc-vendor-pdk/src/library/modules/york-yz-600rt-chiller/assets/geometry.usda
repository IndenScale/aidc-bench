#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "EvaporatorShell"
        {
            color3f[] primvars:displayColor = [(0.14, 0.36, 0.58)]
            double size = 1
            double3 xformOp:scale = (3.9, 0.92, 1.05)
            double3 xformOp:translate = (1.95, 0.52, 0.62)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "CondenserShell"
        {
            color3f[] primvars:displayColor = [(0.19, 0.45, 0.66)]
            double size = 1
            double3 xformOp:scale = (3.9, 0.92, 1.05)
            double3 xformOp:translate = (1.95, 1.54, 0.62)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "MagLevCompressorAndVsd"
        {
            color3f[] primvars:displayColor = [(0.12, 0.20, 0.30)]
            double size = 1
            double3 xformOp:scale = (2.1, 1.65, 1.35)
            double3 xformOp:translate = (1.95, 1.025, 1.875)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "chw_in"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0.0, 0.52, 0.45)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "chw_out"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0.0, 0.52, 0.92)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "cw_in"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0.0, 1.54, 0.45)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "cw_out"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0.0, 1.54, 0.92)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "power_in"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (2.6, 1.025, 2.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
