#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "BaseSkid"
        {
            color3f[] primvars:displayColor = [(0.16, 0.18, 0.20)]
            double size = 1
            double3 xformOp:scale = (5.67, 2.305, 0.42)
            double3 xformOp:translate = (2.835, 1.1525, 0.21)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "EngineQsk78"
        {
            color3f[] primvars:displayColor = [(0.74, 0.16, 0.16)]
            double size = 1
            double3 xformOp:scale = (2.80, 1.65, 1.88)
            double3 xformOp:translate = (2.55, 1.1525, 1.36)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Alternator"
        {
            color3f[] primvars:displayColor = [(0.26, 0.30, 0.35)]
