#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "EnclosureIP31"
        {
            color3f[] primvars:displayColor = [(0.74, 0.77, 0.8)]
            double size = 1
            double3 xformOp:scale = (2.55, 1.46, 2.75)
            double3 xformOp:translate = (1.275, 0.77, 1.375)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "CastResinCoilsAccent"
        {
            color3f[] primvars:displayColor = [(0.78, 0.3, 0.22)]
            double size = 1
            double3 xformOp:scale = (1.95, 0.04, 1.65)
            double3 xformOp:translate = (1.275, 0.02, 1.35)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "mv_in"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0, 0.75, 1.85)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "lv_out"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (1.85, 0.75, 2.75)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "pe_ground"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.35, 1.5, 0.15)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_in"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (1.275, 0, 0.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_out"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (1.275, 0.75, 2.75)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

