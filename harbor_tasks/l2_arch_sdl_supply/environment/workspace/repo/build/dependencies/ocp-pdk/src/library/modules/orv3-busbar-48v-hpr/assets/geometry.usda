#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Enclosure"
        {
            color3f[] primvars:displayColor = [(0.18, 0.24, 0.31)]
            double size = 1
            double3 xformOp:scale = (0.12, 0.08, 2.2)
            double3 xformOp:translate = (0.06, 0.04, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "power_shelf_in"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.06, 0, 0.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "bbu_in"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.06, 0, 0.85)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tray_tap"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.06, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

