#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Enclosure"
        {
            color3f[] primvars:displayColor = [(0.18, 0.24, 0.31)]
            double size = 1
            double3 xformOp:scale = (3, 0.24, 0.16)
            double3 xformOp:translate = (1.5, 0.12, 0.08)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "in"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0, 0.12, 0.08)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "out"
        {
            custom double3 texsys:normal = (1, 0, 0)
            double3 xformOp:translate = (3, 0.12, 0.08)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tap_1"
        {
            custom double3 texsys:normal = (0, 0, -1)
            double3 xformOp:translate = (0.45, 0.12, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tap_2"
        {
            custom double3 texsys:normal = (0, 0, -1)
            double3 xformOp:translate = (1.15, 0.12, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tap_3"
        {
            custom double3 texsys:normal = (0, 0, -1)
            double3 xformOp:translate = (1.85, 0.12, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tap_4"
        {
            custom double3 texsys:normal = (0, 0, -1)
            double3 xformOp:translate = (2.55, 0.12, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

