#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Frame"
        {
            color3f[] primvars:displayColor = [(0.16, 0.21, 0.27)]
            double size = 1
            double3 xformOp:scale = (0.6, 1.068, 2.278)
            double3 xformOp:translate = (0.3, 0.534, 1.139)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "FrontBezel"
        {
            color3f[] primvars:displayColor = [(0.1, 0.14, 0.19)]
            double size = 1
            double3 xformOp:scale = (0.54, 0.025, 2.18)
            double3 xformOp:translate = (0.30000000000000004, 0.0125, 1.1300000000000001)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "rails_ou"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.3, 0, 1.14)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "busbar_slot"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.3, 1.068, 1.14)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "manifold_slot"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.52, 1.068, 1.14)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_in"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.3, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_out"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.3, 1.068, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

